data("airquality")
ozone <- na.omit(airquality$Ozone)  # we remove the NAs values
median_ozone <- median(ozone)
median_ozone
set.seed(123)
n <- length(ozone)
B <- 1000
ozone_boot_samples <- matrix(sample(ozone, n * B, replace = TRUE), nrow = B)
boot_medians <- apply(ozone_boot_samples, 1, median)
# Standard error and bias
se_boot <- sd(boot_medians)
bias_boot <- mean(boot_medians) - median_ozone
se_boot ; bias_boot
library(bootstrap)
install.packages("bootstrap")
install.packages("bootstrap")
install.packages("bootstrap")
library(bootstrap)
set.seed(123)
boot_obj1 <- bootstrap(ozone, nboot = B, theta = median)
se_boot_pkg1 <- sd(boot_obj1$thetastar)
bias_boot_pkg1 <- mean(boot_obj1$thetastar) - median_ozone
library(bootstrap)
set.seed(123)
boot_obj1 <- bootstrap(ozone, nboot = B, theta = median)
se_boot_pkg1 <- sd(boot_obj1$thetastar)
bias_boot_pkg1 <- mean(boot_obj1$thetastar) - median_ozone
se_boot_pkg1 ; bias_boot_pkg1
library(boot)
median_fn <- function(data, indices) median(data[indices])
boot_obj2 <- boot(data = ozone, statistic = median_fn, R = B)
se_boot_pkg2 <- sd(boot_obj2$t)
bias_boot_pkg2 <- mean(boot_obj2$t) - median_ozone
se_boot_pkg2 ; bias_boot_pkg2
hist(boot_medians, probability = TRUE, main = "Bootstrap Sample Medians")
lines(density(boot_medians), col = "blue")
abline(v = median_ozone, col = "red", lwd = 2)
quantile(boot_medians, probs = c(0.05, 0.95))
