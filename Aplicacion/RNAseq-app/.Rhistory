mere_problem <- function(n=4)
{
for (i in 1:n)
{
numbers <- sample(1:6, size = 1, replace = TRUE) # we need to replace because it is a dice
if (length(which(numbers==6))>0) return(TRUE)
}
return(FALSE)
}
nsim<-10000
res <- vector()
for (i in 1:nsim)
{
res[i] <- mere_problem()  # default value n =4
}
# we compute the number of TRUE and calculate the proportion
number_trues <- sum(res)
proportion <- number_trues/(number_trues + sum(!res))
n<-4
exact_prob <- 1 - (5/6)^n
abs(proportion-exact_prob)
