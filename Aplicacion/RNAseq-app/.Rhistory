wind <- na.omit(airquality$Wind)
# Classical 99% CI
t.test(wind, conf.level = 0.99)$conf.int
# Bootstrap 99% CI
wind_boot_samples <- matrix(sample(wind, length(wind) * B, replace = TRUE), nrow = B)
boot_means_wind <- apply(wind_boot_samples, 1, mean)
quantile(boot_means_wind, probs = c(0.005, 0.995))
data("airquality")
ozone <- na.omit(airquality$Ozone)  # filter out missing observations
median_ozone <- median(ozone)
median_ozone
set.seed(123)
n <- length(ozone)
B <- 1000
ozone_boot_samples <- matrix(sample(ozone, size = n * B, replace = TRUE), nrow = B)
boot_medians <- apply(ozone_boot_samples, 1, median)
# We calculate bootstrap standard error and bias
se_manual <- sd(boot_medians)
bias_manual <- mean(boot_medians) - median_ozone
se_manual
bias_manual
library(bootstrap)
set.seed(123)
boot_obj1 <- bootstrap(ozone, nboot = B, theta = median)
se_boot_pkg1 <- sd(boot_obj1$thetastar)
bias_boot_pkg1 <- mean(boot_obj1$thetastar) - median_ozone
se_boot_pkg1
bias_boot_pkg1
library(boot)
median_fn <- function(data, indices) median(data[indices])
boot_obj2 <- boot(data = ozone, statistic = median_fn, R = B)
se_boot_pkg2 <- sd(boot_obj2$t)
bias_boot_pkg2 <- mean(boot_obj2$t) - median_ozone
se_boot_pkg2
bias_boot_pkg2
hist(boot_medians, probability = TRUE, main = "Distribution of Bootstrapped Medians")
lines(density(boot_medians), col = "blue")
abline(v = median_ozone, col = "red", lwd = 2)
quantile(boot_medians, probs = c(0.05, 0.95))
quantile_99 <- quantile(ozone, 0.99)
quantile_99
boot_q99 <- apply(ozone_boot_samples, 1, function(x) quantile(x, 0.99))
se_q99 <- sd(boot_q99)
bias_q99 <- mean(boot_q99) - quantile_99
se_q99
bias_q99
# Visual representation
hist(boot_q99, probability = TRUE, main = "Bootstrap Distribution for 99th Quantile")
lines(density(boot_q99), col = "blue")
abline(v = quantile_99, col = "red", lwd = 2)
# 90% interval for the 99th percentile
quantile(boot_q99, probs = c(0.05, 0.95))
t.test(ozone, conf.level = 0.99)$conf.int
boot_means <- apply(ozone_boot_samples, 1, mean)
quantile(boot_means, probs = c(0.005, 0.995))
wind <- na.omit(airquality$Wind)
# Parametric (t-test) interval
t.test(wind, conf.level = 0.99)$conf.int
# Bootstrap interval
wind_boot_samples <- matrix(sample(wind, size = length(wind) * B, replace = TRUE), nrow = B)
boot_means_wind <- apply(wind_boot_samples, 1, mean)
quantile(boot_means_wind, probs = c(0.005, 0.995))
