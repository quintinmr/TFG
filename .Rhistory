nsim<-1000
set.seed(1)
x<-runif(nsim,-1,1)
y<-runif(nsim,-1,1)
event<-(x^2+y^2<=1)
# Approximation is:
approx <- mean(event)
# Estimation error is:
sd(event)/sqrt(nsim)
## Convergence plot
estim<-cumsum(event)/(1:nsim)
estim.err<-sqrt(cumsum((event-estim)^2))/(1:nsim)
plot(1:nsim,estim,type='l',ylab='Approximation and error limits',
xlab='Number of simulations',main=expression(P(X^2+Y^2<=0)),
ylim=c(0,1))
z<-qnorm(0.025,lower.tail = FALSE)
lines(estim - z*estim.err,col='blue',lwd=2,lty=3)
lines(estim + z*estim.err,col='blue',lwd=2,lty=3)
abline(h=pi/4, col=2)
exact_value <- pi/4
all.equal(approx, exact_value)
