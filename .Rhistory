ylab = "Standardised residuals")
if (!require(lmtest)) install.packages("lmtest", quiet = TRUE)
library(lmtest)
plot(rstandard(mod1) ~ as.numeric(hatco$empresa),
xlab = "Observation order (empresa id)",
ylab = "Std. residual")
dwtest(mod1)   # Durbin‑Watson statistic
qqnorm(rstandard(mod1)); qqline(rstandard(mod1))
ks.test(rstandard(mod1), "pnorm")
if (!require(car)) install.packages("car", quiet = TRUE)
library(car)
crPlots(mod1)
plot(abs(rstandard(mod1)) ~ as.numeric(hatco$empresa),
xlab = "Observation",
ylab = "|Std. residual|",
main = "Magnitude of residuals")
which(abs(rstandard(mod1)) > 2.5)
influenceIndexPlot(mod1, id.n = 4)  # show the 4 most extreme ids
# Removing the two observations identified as highly influential
hatco98 <- hatco[-c(7, 100), ]
# We fit the same full model again using the reduced dataset
mod2 <- lm(fidelidad ~ velocidad + precio + flexprec + imgfabri +
servconj + imgfvent + calidadp,
data = hatco98)
summary(mod2)
step(mod2)
# We apply both forward and backward steps in model selection
step(mod2, direction = "both")
