f1<-function(x) dbeta(x,2.5,5)
f2<-function(x) sin(x)*exp(-x)*dbeta(x,2.5,5)
# Monte Carlo integration
nsim <- 100
a <- 0.2
b <- 0.4
set.seed(1)
x<-runif(nsim, a, b)
f1x<-sapply(x,f1)
# approximation
mfx <- mean(f1x)*(b-a)
mfx
# Evaluate the convergence with a graphic
estim<-cumsum(f1x)/(1:nsim)
std.err<-sqrt(cumsum((f1x-estim)^2))/(1:nsim)
exact_value <- integrate(f1,0.2,0.4)$value
plot(1:nsim,estim,type = 'l', ylab = 'Approximation and confidence limits', xlab = 'Number of simulations')
z<-qnorm(0.025,lower.tail = FALSE)
lines(estim - z*std.err,col='blue',lwd=2,lty=3)
lines(estim + z*std.err,col='blue',lwd=2,lty=3)
abline(h=exact_value,col=2)
# Approximation error
abs(mfx-exact_value)
