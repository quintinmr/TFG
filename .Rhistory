VaR <- quantile(0.995)
VaR
# Parameters of the log normal:
mu <- 3.5 ; sig <- 1.1
# Mean and variance of each payment (X_i)
EX<- exp(mu+sig^2/2) ; EX
VX<- EX^2*(exp(sig^2)-1) ; VX
# Parameter of the Poisson (N)
lam<- 17 # =E[N]=V(N)
# Mean of S_N
ES<-lam*EX ; ES
# Variance of S_N
VS<- lam*VX + lam*EX^2 ; VS
nsim<-5000
# simulate nsim values of S_N:
S <- double(nsim)
set.seed(1)
for (i in 1:nsim){
n <- rpois(1,lam)
if (n>0) S[i] <- sum(rlnorm(n,mu,sig))
}
# the vector S contains the nsim simulated values of S_N
# first approximation of the density function (a histogram)
hist(S,xlim=c(0,7000),breaks=20,prob=TRUE, ylim=c(0,1.2e-3))
# second approximation (a smoothed estimator)
lines(density(S),col="red")
VaR <- quantile(S, 0.995)
VaR
qnorm(0.995, mean=ES, sd=sqrt(VS))
